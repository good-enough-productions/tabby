{
    "name": "tabbytoo",
    "version": "3.2.1",
    "description": "Tabby is a Firefox-first new tab page that shows preview cards for the other tabs in the current window.",
    "private": true,
    "scripts": {
        "gen-manifest:chrome": "node gen-manifest.js chrome",
        "gen-manifest:webext": "node gen-manifest.js webext",
        "gen-manifest:firefox": "npm run gen-manifest:webext",
        "build:chrome": "webpack --config chrome.webpack.config.js && npm run gen-manifest:chrome",
        "build:chrome.dev": "webpack --config chrome.webpack.dev.config.js && npm run gen-manifest:chrome",
        "build:webext": "webpack --config webext.webpack.config.js && npm run gen-manifest:webext",
        "build:webext.dev": "webpack --config webext.webpack.dev.config.js && npm run gen-manifest:webext",
        "build:firefox": "webpack --config firefox.webpack.config.js && npm run gen-manifest:firefox",
        "build:firefox.dev": "webpack --config firefox.webpack.dev.config.js && npm run gen-manifest:firefox",
        "clean:background": "rimraf dist/background/captureTab.js*",
        "clean:newtab": "rimraf dist/newtab",
        "clean:manifest": "rimraf dist/manifest.json",
        "clean": "npm run clean:background && npm run clean:newtab && npm run clean:manifest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Bill13579/tabby.git"
    },
    "author": "BillK <bluesky42624@gmail.com>",
    "license": "MPL-2.0",
    "bugs": {
        "url": "https://github.com/Bill13579/tabby/issues"
    },
    "homepage": "https://github.com/Bill13579/tabby#readme",
    "devDependencies": {
        "circular-dependency-plugin": "^5.2.2",
        "eslint": "^8.34.0",
        "rimraf": "^3.0.2",
        "wasm-pack": "^0.13.1",
        "webextension-polyfill": "^0.10.0",
        "webpack": "^5.94.0",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "dompurify": "^3.0.1",
        "get-favicons": "github:Bill13579/get-favicons",
        "lz-string": "^1.5.0",
        "marked": "^4.2.12",
        "proxy-polyfill": "^0.3.2",
        "smoothscroll-polyfill": "^0.4.4",
        "tabby": "file:"
    }
}
