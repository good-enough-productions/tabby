{

    "manifest_version": 3,
    "name": "TabbyToo - Window and Tab Manager",
    "version": "<this will be filled in when `gen-manifest` gets run>",

    "description": "Manage great amounts of windows and tabs at ease.",
    "icons": {
        "48": "icons/tabbytoo-48.png",
        "96": "icons/tabbytoo-96.png"
    },

    "permissions": [
        "tabs",
        "storage",
        "cookies",
        "contextMenus",
        "webNavigation",
        "unlimitedStorage"
    ],
    "host_permissions": [  ],
    
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },

    "options_ui": {
        "page": "options/options.html",
        "open_in_tab": true
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content/content.js"],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_icon": "icons/tabbytoo-32.png",
        "default_title": "TabbyToo",
        "default_popup": "popup/index.html"
    },
    "sidebar_action": {
        "default_icon": "icons/tabbytoo-32.png",
        "default_title": "TabbyToo",
        "default_panel": "popup/sidebar.html",
        "browser_style": false,
        "open_at_install": false
    },
    "background": {
        "scripts": ["background/background.js", "background/captureTab.js", "background/tmpClear.js", "background/commands.js"],
        "service_worker": "background/background-sw.js"
    },

    "commands": {
        "open-tabby-focus-search": {
            "suggested_key": {
                "default": "Ctrl+Shift+Space",
                "mac": "MacCtrl+Shift+Space"
            },
            "description": "Open TabbyToo, with focus on the search bar"
        },
        "open-tabby-focus-current": {
            "suggested_key": {
                "default": "Alt+Period",
                "mac": "Alt+Period"
            },
            "description": "Open TabbyToo, with focus on the current tab"
        },
        "open-tabby-switch-view": {
            "suggested_key": {
                "default": "Alt+Comma",
                "mac": "Alt+Comma"
            },
            "description": "Switch views"
        },
        "last-used-tab": {
            "suggested_key": {
                "default": "Ctrl+Shift+L",
                "mac": "MacCtrl+Shift+L"
            },
            "description": "Open last used tab"
        },
        "last-used-window": {
            "suggested_key": {
                "default": "Ctrl+Shift+0",
                "mac": "MacCtrl+Shift+0"
            },
            "description": "Open last used window"
        }
    }

}
